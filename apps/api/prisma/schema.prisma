// BackOffice Platform — esquema de datos multi-tenant.
// Base definitiva: MongoDB Atlas (provider mongodb, DATABASE_URL en .env).
// Los enums son String (constantes en src/common/constants.ts) y los campos
// JSON van como String serializado — decisión heredada de la fase SQLite que
// funciona igual en Mongo. Los IDs son cuid mapeados a _id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Usuarios y roles ────────────────────────────────────────────────
// role: SUPER_ADMIN | DEV | COMPANY_ADMIN | COMPANY_VIEWER
model User {
  id               String    @id @default(cuid()) @map("_id")
  email            String    @unique
  passwordHash     String
  name             String
  role             String
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phone            String?
  jobTitle         String?
  // Rol COMPANY_AREA: usuario que solo ve los ítems de SU área de producción
  productionAreaId String?
  active           Boolean   @default(true)
  lastLoginAt      DateTime?
  // Endurecimiento del login: bloqueo temporal por intentos fallidos
  failedLogins     Int       @default(0)
  lockedUntil      DateTime?
  // Tour de bienvenida: se muestra solo hasta que el usuario lo termina
  tourDoneAt       DateTime?
  /// Versión de los términos y condiciones que aceptó (y cuándo)
  termsVersion     Int?
  termsAcceptedAt  DateTime?
  // Rol COMPANY_COURIER (domiciliario): turno y última posición GPS conocida
  onShift          Boolean   @default(false)
  lastLat          Float?
  lastLng          Float?
  lastLocAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs        AuditLog[]
  assignedContacts Contact[]  @relation("AssignedContacts")
  /// Sube al cerrar sesión, cambiar la contraseña, desactivar o cambiar el rol:
  /// los tokens emitidos antes dejan de servir (revocación real del lado servidor)
  sessionVersion   Int        @default(0)
  /// MFA (TOTP): secreto cifrado, activo y último paso usado (anti-repetición)
  mfaSecretEnc     String?
  mfaEnabled       Boolean    @default(false)
  mfaLastStep      Int?
  /// Códigos de recuperación (bcrypt), de un solo uso
  mfaRecoveryJson  String?
}

// ─── Planes ──────────────────────────────────────────────────────────
model Plan {
  id                      String    @id @default(cuid()) @map("_id")
  code                    String    @unique // starter | growth | scale | enterprise | custom-xxx
  name                    String
  priceMonthly            Float // USD; 0 = a medida
  maxBots                 Int // perfiles/modelos
  maxWorkspaces           Int
  maxUsers                Int
  featuresJson            String // string[] serializado
  // IA revendida (modo PLATFORM): conversaciones IA incluidas al mes y precio
  // de cada conversación adicional (USD). 0 = sin incluidas / sin excedente.
  includedAiConversations Int       @default(0)
  extraAiConversationUsd  Float     @default(0)
  highlight               Boolean   @default(false)
  isCustom                Boolean   @default(false)
  active                  Boolean   @default(true)
  companies               Company[]
  createdAt               DateTime  @default(now())

  // Rubro: COMIDAS | WEBCAM | SERVICIOS | VENTAS (COP, IVA incluido, precios "desde")
  // PRO = planes viejos en USD (inactivos para clientes nuevos)
  line            String  @default("PRO")
  currency        String  @default("USD")
  maxLines        Int     @default(1)
  maxCouriers     Int     @default(0)
  minTermMonths   Int     @default(0) // permanencia mínima (montaje gratis)
  setupFeeValue   Float   @default(0) // valor de referencia del montaje (salida anticipada)
  sortOrder       Int     @default(0)
  /// BASICO | INTERMEDIO | MAX (línea WPP: automatización humanizada de WhatsApp)
  tier            String?
  /// Precio mensual en modalidad "Todo incluido" (nosotros gestionamos la IA y Meta).
  /// priceMonthly es la modalidad "Tu IA" (el cliente paga su IA y Meta directo).
  priceManaged    Float   @default(0)
  /// US$ de mensajes de Meta (vía Twilio) incluidos al mes en "Todo incluido"
  includedMetaUsd Float   @default(10)
}

// ─── Empresas (tenants) ──────────────────────────────────────────────
// status: TRIAL | ACTIVE | SUSPENDED | CANCELLED
model Company {
  id                    String    @id @default(cuid()) @map("_id")
  name                  String
  slug                  String    @unique
  legalName             String?
  industry              String?
  country               String?
  city                  String?
  website               String?
  contactEmail          String?
  contactPhone          String?
  status                String    @default("TRIAL")
  planId                String?
  plan                  Plan?     @relation(fields: [planId], references: [id])
  timezone              String    @default("America/Bogota")
  language              String    @default("es")
  logoUrl               String?
  brandColor            String?
  // BYOK: llave de DeepInfra de la empresa — el costo de IA lo asume el cliente
  // directo con el proveedor. Nunca se devuelve completa por el API (se enmascara).
  deepinfraApiKey       String? // cifrada (enc:v1:…) desde oct 2026; texto plano legado se sigue leyendo
  // Quién paga la IA: BYOK (llave propia del cliente, paga directo a DeepInfra)
  // o PLATFORM (llave de BackOffice; se factura por conversación con tope de gasto)
  aiBillingMode         String    @default("BYOK") // BYOK | PLATFORM | HYBRID (las dos, con respaldo)
  aiHybridPrimary       String    @default("BYOK") // en HYBRID: cuál llave va primero (la otra es respaldo)
  aiSpendCapUsd         Float? // tope duro mensual en modo PLATFORM (null = sin tope)
  aiIncludedOverride    Int? // conversaciones incluidas propias (pisa al plan)
  // Parámetros del "Reporte a Gerencia": ahorro = conversaciones IA/mes ÷ capacidad × sueldo
  savingsSalaryUsd      Float     @default(400) // sueldo mensual equivalente de un agente humano
  agentCapacityPerMonth Int       @default(300) // conversaciones que atiende una persona al mes
  // Moneda de la empresa para pantallas de consumo/costos (COP para Nexus; USD disponible)
  currency              String    @default("COP")
  // Configuración del módulo de pedidos (catering): JSON {statuses?, schedule:{days,open,close},
  // orderCutoff, minLeadHours, maxPerSlot, slots, holidays[], nonWorkingDays[]}
  orderConfigJson       String    @default("{}")
  // Plantillas aprobadas de Meta (vía Twilio Content API), por organización:
  // [{key, name, contentSid, category (UTILIDAD|MARKETING), body, variables[]}]
  waTemplatesJson       String    @default("[]")
  notes                 String?
  // Módulos habilitados para el tenant (string[] serializado):
  // inbox, contacts, bots, automations, analytics, billing, team
  modulesJson           String    @default("[\"inbox\",\"contacts\",\"bots\",\"automations\",\"analytics\",\"billing\",\"team\"]")
  // Overrides de límites del plan (JSON {maxBots?, maxUsers?, maxWorkspaces?})
  limitsJson            String    @default("{}")
  /// Productos activos (Automation, Creative, Ads Intelligence): {KEY:{enabled,since,until,requestedAt}}.
  /// null = regla anterior (Automation siempre; Creative y Ads con plan). Ver common/products.ts
  productsJson          String?
  trialEndsAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  users              User[]
  bots               Bot[]
  integrations       Integration[]
  contacts           Contact[]
  conversations      Conversation[]
  automations        Automation[]
  usageRecords       UsageRecord[]
  invoices           Invoice[]
  auditLogs          AuditLog[]
  apiKeys            ApiKey[]
  personaTemplates   PersonaTemplate[]
  payments           Payment[]
  emailMessages      EmailMessage[]
  mediaAssets        MediaAsset[]
  aiUsageEvents      AiUsageEvent[]
  appointments       Appointment[]
  followUps          FollowUp[]
  customers          Customer[]
  products           Product[]
  productionAreas    ProductionArea[]
  orders             Order[]
  orderItems         OrderItem[]
  orderStatusLogs    OrderStatusHistory[]
  reminders          Reminder[]
  feedbacks          Feedback[]
  dailyReports       DailyReport[]
  marketingCampaigns MarketingCampaign[]
  contentPieces      ContentPiece[]
  videoJobs          VideoJob[]

  // Cobro personalizado: precio pactado (pisa al plan) y permanencia
  customPriceMonthly Float?
  /// Registro por la web (autoservicio): rubro, descripción, contacto, plan pedido
  onboardingJson     String?
  /// Extras con sobrecosto mensual: {"social":{"enabled":true,"price":150000,"credits":20}}
  addonsJson         String?
  /// MONTHLY | ANNUAL (anual = 10 mensualidades por 12 meses, se cobra en el mes de inicio)
  billingCycle       String    @default("MONTHLY")
  /// Mes (YYYY-MM) en que arranca el ciclo anual; se repite cada 12 meses
  annualStartPeriod  String?
  contractStartAt    DateTime?
  minTermMonths      Int?
  setupFeeValue      Float?
  // Reseña en Google tras una buena calificación del cliente
  googleReviewUrl    String?
  // Pagos de los pedidos (cuenta Wompi PROPIA de la empresa, secretos cifrados)
  paymentConfigJson  String    @default("{}")
  // Facturación electrónica DIAN (proveedor ALEGRA o SIMULADO), token cifrado
  einvoiceConfigJson String    @default("{}")
  branches           Branch[]
  /// SELF = "Tu IA" (paga su IA y Meta directo) | MANAGED = "Todo incluido" (mes vencido)
  serviceMode        String    @default("SELF")
  /// Código para invitar a otras empresas (programa de referidos)
  referralCode       String?
  /// Empresa que la refirió y estado del premio {status, rewardedAt, adjustmentId}
  referredById       String?
  referralJson       String?
  /// Landing de regalo de la primera suscripción {status, url, notes, deliveredAt}
  landingJson        String?
}

// ─── Bots / Asistentes IA ────────────────────────────────────────────
// status: ACTIVE | PAUSED | DRAFT
model Bot {
  id               String   @id @default(cuid()) @map("_id")
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  status           String   @default("DRAFT")
  provider         String   @default("anthropic") // anthropic | openai | ...
  model            String   @default("claude-sonnet-5")
  temperature      Float    @default(0.7)
  maxTokens        Int      @default(1024)
  systemPrompt     String   @default("")
  // personalidad: JSON {tone, style, limits, bio, language}
  personalityJson  String   @default("{}")
  memoryEnabled    Boolean  @default(true)
  welcomeMessage   String?
  handoffKeywords  String? // separado por comas
  businessHours    String? // JSON {enabled, schedule}
  // Tiempos de respuesta humanizados (segundos): la IA espera entre min y max
  replyDelayMinSec Int      @default(3)
  replyDelayMaxSec Int      @default(12)
  typingSimulation Boolean  @default(true) // muestra "escribiendo…" antes de responder
  // Habilidades de venta (JSON {goal, style, catalog, upsell, objections})
  salesJson        String   @default("{}")
  // Motor: ORDERS = extracción estructurada de pedidos (Nexus) · AGENT = agente
  // con herramientas sobre los módulos (menú, envío, pedidos, seguimiento…)
  engineMode       String   @default("ORDERS")
  // Quién paga la IA de ESTE asistente: INHERIT (lo de la empresa) | BYOK |
  // PLATFORM (asistente vendido con la IA de BackOffice) | HYBRID
  aiSource         String   @default("INHERIT")
  // Herramientas del agente y su permiso: [{tool, access: "read"|"write"}]
  toolsJson        String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  conversations Conversation[]
  integrations  Integration[]
  aiUsageEvents AiUsageEvent[]
}

// ─── Integraciones / Canales / Líneas ────────────────────────────────
// type: WHATSAPP | INSTAGRAM | MESSENGER | TELEGRAM | META_ADS | N8N | GOOGLE_CALENDAR | WEBHOOK
// status: DISCONNECTED | PENDING | CONNECTED | ERROR
// Una empresa puede tener VARIAS integraciones WHATSAPP = varias líneas/números.
// Cada línea decide cómo responde su IA:
//   promptMode INHERIT → usa las instrucciones generales del bot asignado
//   promptMode CUSTOM  → instrucciones propias de la línea (100% personalizable)
model Integration {
  id         String    @id @default(cuid()) @map("_id")
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  botId      String?
  bot        Bot?      @relation(fields: [botId], references: [id])
  type       String
  name       String
  status     String    @default("DISCONNECTED")
  // config: JSON — para WhatsApp: {phoneNumberId, wabaId, displayPhone}; vacío hasta conectar
  configJson String    @default("{}")
  connectUrl String? // link de conexión (OAuth de Meta, deep link, etc.)
  webhookUrl String?
  lastSyncAt DateTime?
  errorMsg   String?

  // Personalización de IA por línea
  promptMode               String  @default("INHERIT") // INHERIT | CUSTOM
  overridePrompt           String  @default("")
  overridePersonalityJson  String  @default("{}") // {tone, style, limits, bio, language}
  overrideWelcome          String?
  overrideHandoff          String?
  overrideModel            String?
  overrideTemperature      Float?
  // Tiempos de respuesta propios de la línea (null = hereda del bot)
  overrideReplyDelayMinSec Int?
  overrideReplyDelayMaxSec Int?
  // Habilidades de venta propias de la línea (JSON {goal, style, catalog, upsell, objections})
  overrideSalesJson        String  @default("{}")

  conversations Conversation[]
  mediaAssets   MediaAsset[]
  aiUsageEvents AiUsageEvent[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ─── Biblioteca de personalidades ────────────────────────────────────
// Plantillas listas para aplicar a un bot o a una línea con un clic.
// companyId null = plantilla global de la plataforma (gestionada por BackOffice);
// con companyId = plantilla propia de esa empresa.
model PersonaTemplate {
  id              String   @id @default(cuid()) @map("_id")
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  category        String   @default("General") // Clínicas, Estudios webcam, Automotriz, Ventas…
  description     String?
  systemPrompt    String
  personalityJson String   @default("{}")
  welcomeMessage  String?
  handoffKeywords String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── CRM: contactos / leads ──────────────────────────────────────────
// stage: CURIOSO | POTENCIAL | CALIENTE | CLIENTE | DESCARTADO
model Contact {
  id             String   @id @default(cuid()) @map("_id")
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  channel        String   @default("WHATSAPP")
  stage          String   @default("CURIOSO")
  tagsJson       String   @default("[]")
  notes          String?
  assignedToId   String?
  assignedTo     User?    @relation("AssignedContacts", fields: [assignedToId], references: [id])
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())

  // Módulo de pedidos: persona dentro de una empresa cliente (Customer)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  conversations Conversation[]
  appointments  Appointment[]
  followUps     FollowUp[]
  orders        Order[]
  feedbacks     Feedback[]

  // No recibir campañas ni seguimientos (pidió la baja por WhatsApp o a mano)
  optOut     Boolean   @default(false)
  optOutAt   DateTime?
  // Embudo configurable (null = embudo estándar CURIOSO → CLIENTE)
  pipelineId String?
  // Identificadores en otros canales (Instagram / Messenger)
  externalId String?
  /// Primer origen del contacto (anuncio, publicación o directo); no se sobreescribe
  originJson String?
}

// ─── Conversaciones y mensajes ───────────────────────────────────────
// status: OPEN | PENDING | HANDOFF | RESOLVED
model Conversation {
  id             String       @id @default(cuid()) @map("_id")
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  botId          String?
  bot            Bot?         @relation(fields: [botId], references: [id])
  integrationId  String? // línea/número por el que entró la conversación
  integration    Integration? @relation(fields: [integrationId], references: [id])
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel        String       @default("WHATSAPP")
  status         String       @default("OPEN")
  needsAttention Boolean      @default(false)
  // MODO HUMANO: pausa del bot POR conversación (nunca global) y quién atiende
  botPaused      Boolean      @default(false)
  attendedByName String?
  // Estado de la máquina conversacional del motor: {state, missingFields, draftOrderId}
  aiStateJson    String       @default("{}")
  customerId     String? // empresa cliente (módulo pedidos)
  unreadCount    Int          @default(0)
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  /// De dónde llegó: anuncio de Meta, publicación o directo (common/chat-origin.ts)
  originJson     String?

  messages Message[]
  orders   Order[]

  @@index([companyId, contactId])
  @@index([companyId, lastMessageAt])
}

// direction: IN | OUT — author: CONTACT | BOT | AGENT
model Message {
  id             String       @id @default(cuid()) @map("_id")
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  author         String
  authorName     String? // usuario del equipo que escribió (modo humano)
  content        String
  type           String       @default("TEXT") // TEXT | AUDIO | IMAGE | DOCUMENT
  fileName       String? // archivo en uploads/<companyId>/ para audio/imagen/documento
  transcription  String? // transcripción de audios entrantes
  // Proveedor (Twilio): idempotencia y estados de entrega
  providerId     String? // MessageSid de Twilio — idempotencia de reintentos
  deliveryStatus String? // QUEUED | SENT | DELIVERED | READ | FAILED
  // Transparencia de costos Meta (salientes): SERVICIO | UTILIDAD | MARKETING
  metaCategory   String?
  metaCostUsd    Float?
  tokens         Int?
  mediaAssetId   String? // foto de la galería enviada en este mensaje
  // Ubicación compartida por WhatsApp (type LOCATION)
  latitude       Float?
  longitude      Float?
  mediaAsset     MediaAsset?  @relation(fields: [mediaAssetId], references: [id])
  createdAt      DateTime     @default(now())

  // Lo que la IA leyó de una imagen (comprobante de pago, foto)
  analysisJson String?

  @@index([conversationId, createdAt])
  @@index([providerId])
}

// ═══ MÓDULO DE PEDIDOS (catering — primera empresa: Nexus) ═══════════
// Todo aislado por companyId. Nada hardcodeado a Nexus: catálogo, áreas,
// reglas y plantillas viven en configuración por organización.

// Empresa cliente del tenant (p. ej. las ~10 empresas a las que Nexus vende).
model Customer {
  id            String    @id @default(cuid()) @map("_id")
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  taxId         String? // NIT
  // Direcciones de entrega: [{label, address, city, instructions}]
  addressesJson String    @default("[]")
  notes         String? // condiciones particulares
  active        Boolean   @default(true)
  deletedAt     DateTime? // soft delete
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contacts  Contact[]
  orders    Order[]
  feedbacks Feedback[]

  @@index([companyId, name])
}

// Catálogo configurable por organización.
model Product {
  id                String          @id @default(cuid()) @map("_id")
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  category          String? // p. ej. Almuerzos, Refrigerios, Bebidas
  unit              String          @default("unidad") // unidad de medida
  // Presentaciones: [{name, note?}] — p. ej. bandeja x10, individual
  presentationsJson String          @default("[]")
  price             Float? // precio unitario en la moneda de la empresa (lo cotiza el agente)
  productionAreaId  String? // área responsable por defecto
  productionArea    ProductionArea? @relation(fields: [productionAreaId], references: [id], onDelete: SetNull)
  active            Boolean         @default(true)
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  orderItems OrderItem[]

  // Agotado (hasta una fecha o indefinido) — el agente no lo ofrece
  soldOut      Boolean   @default(false)
  soldOutUntil DateTime?
  imageFile    String? // foto para el menú digital (uploads/<companyId>/)

  @@index([companyId, active])
}

// Áreas internas (cocina, empaque, logística, despacho…) configurables.
model ProductionArea {
  id                  String   @id @default(cuid()) @map("_id")
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  // Responsables: [{name, phone?, email?}]
  responsiblesJson    String   @default("[]")
  notifyChannel       String   @default("PANEL") // PANEL | WHATSAPP | EMAIL
  notifyTarget        String? // teléfono o correo según canal
  // Anticipación de recordatorio para esta área (horas antes de la entrega)
  reminderHoursBefore Int      @default(24)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  products   Product[]
  orderItems OrderItem[]

  @@index([companyId, active])
}

// El pedido. Estados default (configurables en Company.orderConfigJson):
// borrador → confirmado → programado → en_produccion → listo → empacado →
// despachado → entregado. Además: cancelado, requiere_atencion.
// La trazabilidad llega HASTA EL DESPACHO/ENTREGA — no hay seguimiento en ruta.
model Order {
  id                  String        @id @default(cuid()) @map("_id")
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactId           String? // persona que hizo el pedido
  contact             Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversationId      String? // conversación de WhatsApp que lo originó
  conversation        Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status              String        @default("borrador")
  deliveryAt          DateTime // fecha/hora de entrega acordada
  // Snapshot de la dirección al momento del pedido {label, address, city, instructions}
  deliveryAddressJson String        @default("{}")
  observations        String?
  takenByType         String        @default("IA") // IA | HUMANO
  takenByName         String? // nombre del usuario si fue humano
  // Confianza de la extracción de la IA (0-1) y si requirió corrección posterior
  aiConfidence        Float?
  correctedAfterAi    Boolean       @default(false) // alimenta el indicador de precisión (98%)
  // Domicilios: seguimiento público con marca + domiciliario asignado
  trackingToken       String? // link público /t/<token> (sin login, sin ids internos)
  courierId           String? // User con rol COMPANY_COURIER
  subtotal            Float?
  deliveryFee         Float?
  total               Float?
  distanceKm          Float?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  etaAt               DateTime? // hora estimada de llegada (se recalcula con el GPS)
  deliveryProofFile   String? // foto de la entrega en uploads/<companyId>/
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  reminders     Reminder[]
  feedback      Feedback?

  // Origen del pedido: WHATSAPP | MENU | MANUAL | RAPPI | UBER_EATS | WEB | OTRO
  source           String    @default("WHATSAPP")
  externalId       String? // id en la plataforma externa (idempotencia)
  branchId         String? // sucursal que despacha
  // Promociones
  discount         Float?
  couponCode       String?
  // Cobro del pedido: NONE | PENDING | REPORTED | PAID | FAILED
  paymentStatus    String    @default("NONE")
  paymentMethod    String?
  paymentLinkUrl   String?
  paymentRef       String?
  paidAt           DateTime?
  receiptMessageId String? // comprobante enviado por el cliente
  receiptJson      String? // lo que leyó la IA del comprobante
  // Alertas de domicilio
  delayAlertedAt   DateTime?
  // Factura electrónica
  einvoiceStatus   String? // EMITIDA | ERROR
  einvoiceNumber   String?
  einvoiceId       String?
  einvoiceError    String?

  @@index([companyId, deliveryAt])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([trackingToken])
  @@index([companyId, courierId, status])
}

// Ítem del pedido, asignado a un área. Cada área ve SOLO sus ítems.
model OrderItem {
  id               String          @id @default(cuid()) @map("_id")
  companyId        String // desnormalizado: filtro de tenant directo e índices
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String // snapshot (el catálogo puede cambiar)
  quantity         Float
  unit             String          @default("unidad")
  presentation     String?
  specifications   String? // "sin cebolla", "vegetariano x5"…
  observations     String?
  productionAreaId String?
  productionArea   ProductionArea? @relation(fields: [productionAreaId], references: [id], onDelete: SetNull)
  areaStatus       String          @default("pendiente") // pendiente | lista
  areaReadyAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([companyId, productionAreaId, areaStatus])
  @@index([orderId])
}

// Trazabilidad: APPEND-ONLY. Jamás se edita ni se borra (garantizado por
// diseño: no existen endpoints de update/delete y hay test que lo verifica).
model OrderStatusHistory {
  id         String   @id @default(cuid()) @map("_id")
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  authorType String   @default("SISTEMA") // IA | USUARIO | SISTEMA
  authorName String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([companyId, createdAt])
}

// Recordatorio programado (a áreas, despacho o cliente).
// El job que los despacha es idempotente: status + sentAt lo garantizan.
model Reminder {
  id            String    @id @default(cuid()) @map("_id")
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind          String    @default("AREA") // AREA | DESPACHO | CLIENTE | OTRO
  // Destinatario: {name, phone?, email?, productionAreaId?}
  recipientJson String    @default("{}")
  channel       String    @default("PANEL") // WHATSAPP | EMAIL | PANEL
  scheduledAt   DateTime
  templateKey   String? // plantilla configurada en la organización
  bodyRendered  String? // mensaje final renderizado
  status        String    @default("PENDIENTE") // PENDIENTE | ENVIADO | FALLIDO | CANCELADO
  attempts      Int       @default(0)
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, status, scheduledAt])
}

// Retroalimentación post-entrega, ligada al pedido.
model Feedback {
  id              String    @id @default(cuid()) @map("_id")
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  requestedAt     DateTime  @default(now())
  respondedAt     DateTime?
  rating          Int? // 1-5 si se logra extraer
  comment         String?
  sentiment       String? // POSITIVO | NEUTRO | NEGATIVO
  alerted         Boolean   @default(false) // insatisfacción → alerta inmediata
  status          String    @default("PENDIENTE") // PENDIENTE | RESPONDIDO | SIN_RESPUESTA
  createdAt       DateTime  @default(now())
  reviewRequested Boolean   @default(false) // se le pidió reseña en Google

  @@index([companyId, status])
}

// ─── Reporte diario del módulo de pedidos (Fase 6) ───────────────────
// Se genera por job (o a demanda), queda guardado en el panel y se envía
// por el canal configurado en orderConfigJson.dailyReport.
// ─── Marketing (extra por empresa: contenido para redes y campañas) ───
// status campaña: BORRADOR | ACTIVA | PAUSADA | CERRADA
model MarketingCampaign {
  id           String    @id @default(cuid()) @map("_id")
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  objective    String? // qué busca la campaña (ventas, alcance, lanzamiento…)
  status       String    @default("BORRADOR")
  // Canales destino: ["instagram","tiktok","facebook","youtube"]
  channelsJson String    @default("[]")
  startsAt     DateTime?
  endsAt       DateTime?
  budgetUsd    Float?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  pieces ContentPiece[]

  @@index([companyId, status])
}

// Pieza de contenido: reel, post, historia o anuncio.
// type: REEL | POST | STORY | AD — status: IDEA | BORRADOR | LISTO | PROGRAMADO | PUBLICADO
model ContentPiece {
  id                String             @id @default(cuid()) @map("_id")
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId        String?
  campaign          MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  type              String             @default("POST")
  status            String             @default("IDEA")
  title             String
  brief             String? // idea/brief de entrada para la IA
  copy              String? // caption generado o escrito
  hashtagsJson      String             @default("[]")
  script            String? // guion (para reels/videos)
  channel           String? // instagram | tiktok | facebook | youtube
  scheduledAt       DateTime?
  publishedAt       DateTime?
  videoJobId        String?
  assetUrl          String? // video/imagen final (cuando exista)
  /// Redes sociales con IA: imagen generada, destinos y resultado de la publicación
  imagePrompt       String?
  assetFile         String? // archivo en uploads/<empresa>/ (imagen o video)
  assetMime         String?
  mediaToken        String? // token público para que Meta descargue el archivo
  targetsJson       String             @default("[]") // ["facebook","instagram"]
  publishResultJson String? // {facebook:{id,url}, instagram:{id,containerId}}
  publishError      String?
  publishAttempts   Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  /// Diseño editable del que salió la imagen (y su versión)
  designId          String?
  designVersion     Int?
  /// Categoría para las reglas de autonomía (PRODUCTO | PROMO | TIPS | MARCA | OTRO)
  category          String?
  /// Aprobación humana: quién y cuándo (o por qué se rechazó)
  approvedBy        String?
  approvedAt        DateTime?
  reviewNote        String?
  autoApproved      Boolean?

  @@index([companyId, status])
  @@index([companyId, scheduledAt])
}

// Tarea de generación de video (integración MoneyPrinterTurbo — cascarón).
// state: PENDIENTE | PROCESANDO | COMPLETO | FALLIDO
model VideoJob {
  id             String   @id @default(cuid()) @map("_id")
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pieceId        String?
  provider       String   @default("MPT") // MoneyPrinterTurbo
  externalTaskId String? // task_id del generador
  paramsJson     String   @default("{}")
  state          String   @default("PENDIENTE")
  progress       Int      @default(0)
  videoUrl       String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId, state])
}

model DailyReport {
  id        String    @id @default(cuid()) @map("_id")
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD del día reportado (zona de la empresa)
  dataJson  String    @default("{}")
  channel   String? // PANEL | EMAIL — cómo se entregó
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([companyId, date])
}

// NOTA UsageLog: el consumo de IA ya se registra en AiUsageEvent (tokens/costo
// por respuesta) y el de Meta se registra por mensaje saliente en
// Message.metaCategory/metaCostUsd; UsageRecord agrega el diario. La pantalla
// de consumos de la organización se alimenta de esas tres fuentes.

// ─── Agenda de citas ─────────────────────────────────────────────────
// Lo que promete la landing: "agendan citas 24/7". Hoy se crean manualmente
// o desde el chat; el motor de IA las creará solo (source IA) en fase 2.
// status: SCHEDULED | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW
model Appointment {
  id             String    @id @default(cuid()) @map("_id")
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title          String
  notes          String?
  location       String?
  startsAt       DateTime
  durationMin    Int       @default(30)
  status         String    @default("SCHEDULED")
  source         String    @default("MANUAL") // MANUAL | IA
  createdBy      String? // nombre del actor
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // ── Reservas (opcionales: las citas anteriores siguen igual) ──
  /// Espacio o recurso reservado (orderConfig.bookings.resources[].id)
  resourceId     String?
  /// Servicio reservable (orderConfig.bookings.services[].key)
  serviceKey     String?
  /// Fin calculado (startsAt + durationMin)
  endsAt         DateTime?
  /// Chat donde se pidió (para confirmaciones y recordatorios)
  conversationId String?
  /// Cambios: [{at, by, action, from?, to?, note?}]
  historyJson    String?
  /// Evita crear dos veces la misma reserva por reintentos
  idempotencyKey String?

  @@index([companyId, startsAt])
  @@index([companyId, resourceId, startsAt])
}

/// Bloqueo de un tramo de un recurso: el índice único impide reservar dos veces
/// el mismo espacio en el mismo intervalo, aunque dos pedidos lleguen a la vez.
/// Una reserva ocupa un bloqueo por cada tramo (orderConfig.bookings.slotMinutes).
model BookingLock {
  id            String   @id @default(cuid()) @map("_id")
  companyId     String
  resourceId    String
  slotStart     DateTime
  appointmentId String
  createdAt     DateTime @default(now())

  @@unique([companyId, resourceId, slotStart])
  @@index([appointmentId])
}

/// Aviso al cliente de una reserva (confirmación, recordatorio, cambio o cancelación),
/// enviado por el canal del chat. Único por reserva + tipo + momento (no se duplica).
model BookingNotice {
  id            String    @id @default(cuid()) @map("_id")
  companyId     String
  appointmentId String
  /// CONFIRMATION | REMINDER | RESCHEDULE | CANCELLATION
  kind          String
  scheduledAt   DateTime
  /// PENDING | SENDING | SENT | SKIPPED | FAILED | CANCELLED
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  /// Por qué no se envió (sin chat, fuera de 24 h sin plantilla, el cliente pidió no recibir…)
  skipReason    String?
  messageId     String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())

  @@unique([appointmentId, kind, scheduledAt])
  @@index([status, scheduledAt])
}

// ─── Seguimientos ────────────────────────────────────────────────────
// "Seguimientos pendientes" del reporte a gerencia: recordatorios sobre
// contactos (llamar, reintentar venta, confirmar cita…).
// status: PENDING | DONE | CANCELLED
model FollowUp {
  id        String    @id @default(cuid()) @map("_id")
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  note      String
  dueAt     DateTime
  status    String    @default("PENDING")
  createdBy String?
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId, dueAt])
}

// ─── Galería de medios ───────────────────────────────────────────────
// Fotos que la empresa carga para que la IA (o un agente) las envíe en el chat.
// priceUsd > 0 = contenido de pago (PPV) — la IA lo ofrece según sus reglas de venta.
model MediaAsset {
  id            String       @id @default(cuid()) @map("_id")
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integrationId String? // línea a la que pertenece (null = disponible para todas)
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  name          String
  fileName      String // nombre aleatorio en disco (uploads/<companyId>/)
  mimeType      String
  sizeBytes     Int
  priceUsd      Float        @default(0)
  tagsJson      String       @default("[]")
  active        Boolean      @default(true)
  timesSent     Int          @default(0)
  messages      Message[]
  createdAt     DateTime     @default(now())
}

// ─── Consumo de IA a nivel de evento ─────────────────────────────────
// Un registro por cada respuesta generada por la IA. Lo escribe el motor
// (fase 2); el seed genera histórico demo. Alimenta los paneles de consumo
// con filtros por línea/modelo y proyección. El costo lo asume la empresa
// directo con DeepInfra (BYOK).
model AiUsageEvent {
  id             String       @id @default(cuid()) @map("_id")
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integrationId  String? // línea que originó la respuesta
  integration    Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  botId          String?
  bot            Bot?         @relation(fields: [botId], references: [id], onDelete: SetNull)
  model          String // id DeepInfra
  inputTokens    Int
  outputTokens   Int
  costUsd        Float
  billedTo       String       @default("BYOK") // BYOK | PLATFORM (IA revendida)
  conversationId String? // para contar "conversaciones IA" del mes
  createdAt      DateTime     @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, integrationId, createdAt])
  @@index([companyId, billedTo, createdAt])
}

// ─── Catálogo de modelos IA (DeepInfra) ──────────────────────────────
// Costos por millón de tokens que se declaran al cliente (consumo al costo).
model AiModel {
  id                     String   @id @default(cuid()) @map("_id")
  provider               String   @default("DEEPINFRA")
  modelId                String   @unique // ej. meta-llama/Llama-3.3-70B-Instruct
  name                   String
  inputCostPerMTok       Float // USD por 1M tokens de entrada
  outputCostPerMTok      Float // USD por 1M tokens de salida
  contextK               Int      @default(128)
  recommended            Boolean  @default(false)
  active                 Boolean  @default(true)
  notes                  String?
  /// Conversaciones del paquete de IA que gasta cada conversación con este
  /// modelo (los premium gastan más para no vender a pérdida)
  creditsPerConversation Int      @default(1)
  createdAt              DateTime @default(now())
}

// ─── Automatizaciones ────────────────────────────────────────────────
// type: FLOW | CONTENT | REPORT | INTERNAL — status: ACTIVE | PAUSED | DRAFT
model Automation {
  id          String    @id @default(cuid()) @map("_id")
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        String    @default("FLOW")
  trigger     String? // descripción del disparador
  status      String    @default("DRAFT")
  configJson  String    @default("{}")
  lastRunAt   DateTime?
  runsCount   Int       @default(0)
  successRate Float     @default(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  runs AutomationRun[]
}

// status: SUCCESS | FAILED | RUNNING
model AutomationRun {
  id           String     @id @default(cuid()) @map("_id")
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status       String
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  log          String?
}

// ─── Consumo y facturación ───────────────────────────────────────────
model UsageRecord {
  id              String   @id @default(cuid()) @map("_id")
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date            DateTime // día (00:00)
  messagesIn      Int      @default(0)
  messagesOut     Int      @default(0)
  aiTokens        Int      @default(0)
  aiCostUsd       Float    @default(0)
  storageMb       Float    @default(0)
  storageCostUsd  Float    @default(0)
  waConversations Int      @default(0)
  waCostUsd       Float    @default(0)

  @@unique([companyId, date])
}

// status: PAID | PENDING | OVERDUE
model Invoice {
  id                String    @id @default(cuid()) @map("_id")
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period            String // "2026-08"
  planAmount        Float
  consumptionAmount Float
  totalAmount       Float
  status            String    @default("PENDING")
  issuedAt          DateTime  @default(now())
  paidAt            DateTime?
  payments          Payment[]

  currency  String  @default("USD")
  // Líneas: [{kind: PLAN|ADJUSTMENT|AI|WHATSAPP|STORAGE|SETUP, concept, amount}]
  linesJson String  @default("[]")
  notes     String?
}

// ─── Pagos (pasarela) ────────────────────────────────────────────────
// provider: WOMPI (Colombia, activo) | STRIPE (internacional, pendiente)
// status: PENDING | APPROVED | DECLINED | VOIDED | ERROR
model Payment {
  id            String   @id @default(cuid()) @map("_id")
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])
  provider      String   @default("WOMPI")
  reference     String   @unique // referencia enviada a la pasarela
  amountUsd     Float
  amountInCents Int // en moneda local (COP centavos)
  currency      String   @default("COP")
  status        String   @default("PENDING")
  checkoutUrl   String?
  providerTxId  String? // id de transacción en Wompi
  paymentMethod String? // CARD, NEQUI, PSE, BANCOLOMBIA_TRANSFER…
  eventsLog     String   @default("[]") // eventos del webhook, serializados
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // Para qué es: INVOICE (mensualidad) | AI_CREDITS (paquete prepago de IA)
  purpose       String   @default("INVOICE")
  metaJson      String   @default("{}")
}

// ─── Correos a empresas ──────────────────────────────────────────────
// status: QUEUED | SENT | FAILED
model EmailMessage {
  id        String    @id @default(cuid()) @map("_id")
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  toEmail   String
  subject   String
  body      String // HTML
  status    String    @default("QUEUED")
  error     String?
  actorName String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─── Auditoría ───────────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid()) @map("_id")
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  actorName String
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  action    String // company.create, bot.update, user.invite, ...
  entity    String
  entityId  String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}

// ─── API keys (panel dev) ────────────────────────────────────────────
model ApiKey {
  id         String    @id @default(cuid()) @map("_id")
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  prefix     String // visible: bo_live_xxxx
  hash       String
  scopesJson String    @default("[]")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// ─── Configuración global de plataforma ──────────────────────────────
model PlatformSetting {
  key       String   @id @map("_id")
  value     String
  updatedAt DateTime @updatedAt
}

/// Rastro GPS de un domiciliario en turno (para el mapa en vivo y la ruta del
/// día). Se depura a los 7 días con el cron de domicilios.
model CourierPing {
  id        String   @id @default(cuid()) @map("_id")
  companyId String
  userId    String
  lat       Float
  lng       Float
  accuracy  Float?
  speed     Float? // m/s
  heading   Float?
  createdAt DateTime @default(now())

  @@index([companyId, userId, createdAt])
  @@index([createdAt])
}

/// Ajustes de cobro por empresa: un cargo, un descuento o un precio pactado
/// para un mes o un rango de meses ("este mes se le cobra esto").
model BillingAdjustment {
  id          String   @id @default(cuid()) @map("_id")
  companyId   String
  // CHARGE (cargo extra) | DISCOUNT (descuento) | PRICE (precio del plan para esos meses)
  kind        String
  concept     String
  amount      Float    @default(0) // en la moneda de la factura
  percent     Float? // DISCOUNT porcentual sobre el plan (pisa amount)
  startPeriod String // YYYY-MM
  endPeriod   String? // YYYY-MM inclusive; null = solo startPeriod (o indefinido si recurring)
  recurring   Boolean  @default(false)
  active      Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([companyId, startPeriod])
}

/// Paquetes prepagos de IA de BackOffice (catálogo de plataforma).
model AiCreditPackage {
  id             String   @id @default(cuid()) @map("_id")
  name           String
  conversations  Int
  price          Float
  currency       String   @default("COP")
  validityMonths Int      @default(12)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

/// Saldo prepago de una empresa: cada compra/regalo es un lote con vencimiento;
/// el consumo descuenta del lote más antiguo (FIFO).
model AiCreditLot {
  id           String   @id @default(cuid()) @map("_id")
  companyId    String
  source       String // PURCHASE | GRANT
  packageId    String?
  total        Int
  remaining    Int
  expiresAt    DateTime
  paymentRef   String?
  note         String?
  alertedLow   Boolean  @default(false)
  alertedEmpty Boolean  @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([companyId, expiresAt])
}

/// Consumo de créditos: 1 por conversación atendida con la IA de BackOffice
/// por ventana de 24 h (o por consulta fuera de chat).
model AiCreditUse {
  id             String   @id @default(cuid()) @map("_id")
  companyId      String
  conversationId String?
  purpose        String   @default("CHAT") // CHAT | CONSULTA | MARKETING | SETUP
  fromIncluded   Boolean  @default(false) // salió de lo incluido en el plan
  lotId          String?
  createdAt      DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, conversationId, createdAt])
}

/// Campañas por WhatsApp (envío masivo segmentado).
model Broadcast {
  id               String    @id @default(cuid()) @map("_id")
  companyId        String
  name             String
  integrationId    String // línea que envía
  segmentJson      String    @default("{}")
  message          String
  templateKey      String? // plantilla aprobada para contactos fuera de la ventana de 24 h
  status           String    @default("DRAFT") // DRAFT | SCHEDULED | SENDING | SENT | CANCELLED
  scheduledAt      DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  recipientsCount  Int       @default(0)
  estimatedCostUsd Float     @default(0)
  createdBy        String?
  createdAt        DateTime  @default(now())

  recipients BroadcastRecipient[]

  @@index([companyId, createdAt])
  @@index([status, scheduledAt])
}

model BroadcastRecipient {
  id             String    @id @default(cuid()) @map("_id")
  broadcastId    String
  broadcast      Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  companyId      String
  contactId      String
  conversationId String?
  messageId      String?
  status         String    @default("PENDING") // PENDING | QUEUED | SKIPPED | FAILED
  skipReason     String?
  createdAt      DateTime  @default(now())

  @@index([broadcastId])
  @@index([companyId, contactId])
}

/// Promociones y cupones (porcentaje, valor fijo o domicilio gratis).
model Promotion {
  id             String    @id @default(cuid()) @map("_id")
  companyId      String
  code           String? // null = se aplica sola (combo/promo del día)
  name           String
  description    String?
  kind           String // PERCENT | FIXED | FREE_DELIVERY
  value          Float     @default(0)
  minSubtotal    Float?
  productIdsJson String    @default("[]") // vacío = todo el menú
  startsAt       DateTime?
  endsAt         DateTime?
  maxUses        Int?
  usedCount      Int       @default(0)
  public         Boolean   @default(true) // el agente la puede ofrecer
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@index([companyId, active])
}

/// Respuestas rápidas del equipo humano en la bandeja ("/saludo").
model QuickReply {
  id        String   @id @default(cuid()) @map("_id")
  companyId String
  shortcut  String
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// Sucursales: cada una despacha desde su ubicación; el pedido va a la más cercana.
model Branch {
  id        String   @id @default(cuid()) @map("_id")
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  lat       Float
  lng       Float
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([companyId, active])
}

/// Base de conocimiento: documentos (texto, página web o PDF) en fragmentos
/// que el agente consulta con buscar_conocimiento.
model KnowledgeDoc {
  id        String   @id @default(cuid()) @map("_id")
  companyId String
  title     String
  source    String // TEXT | URL | PDF
  url       String?
  status    String   @default("READY") // READY | ERROR
  error     String?
  chars     Int      @default(0)
  chunks    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([companyId])
}

model KnowledgeChunk {
  id        String @id @default(cuid()) @map("_id")
  companyId String
  docId     String
  idx       Int
  text      String

  @@index([companyId, docId])
}

/// Embudos de venta configurables por empresa.
model Pipeline {
  id         String   @id @default(cuid()) @map("_id")
  companyId  String
  name       String
  // [{key, label, kind: OPEN|WON|LOST}]
  stagesJson String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([companyId])
}

/// Candado de idempotencia de pedidos externos: (empresa, origen, id externo)
/// es único, así N reintentos simultáneos del integrador crean UN solo pedido.
model InboundOrderKey {
  id         String   @id @default(cuid()) @map("_id")
  companyId  String
  source     String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([companyId, source, externalId])
}

/// Uso diario de las llaves genéricas (Gemini) del registro y el acompañamiento:
/// se rota a la siguiente al llegar al tope propio o cuando Google dice "agotada".
model AiKeyUsage {
  id          String    @id @default(cuid()) @map("_id")
  provider    String
  fingerprint String // sha256 corto de la llave (jamás la llave)
  day         String // YYYY-MM-DD
  requests    Int       @default(0)
  tokens      Int       @default(0)
  exhaustedAt DateTime?
  lastError   String?
  updatedAt   DateTime  @updatedAt

  @@unique([provider, fingerprint, day])
}

/// Cada mensaje que mandan los complementos automáticos (reactivación y
/// cobranza) y su resultado: respondió, volvió a comprar, pagó.
model AddonTouch {
  id             String    @id @default(cuid()) @map("_id")
  companyId      String
  /// REACTIVATION | COLLECTIONS
  addon          String
  contactId      String?
  conversationId String?
  receivableId   String?
  /// Escalón: días sin comprar (30/60/90) o número de recordatorio (1, 2, 3)
  step           Int       @default(1)
  messageId      String?
  /// SENT | SKIPPED | REPLIED | RECOVERED | PAID
  status         String    @default("SENT")
  skipReason     String?
  /// Venta recuperada o pago recibido después del mensaje
  amount         Float?
  resultAt       DateTime?
  createdAt      DateTime  @default(now())

  @@index([companyId, addon, createdAt])
  @@index([contactId])
}

/// Cuentas por cobrar de la empresa (cobranza humanizada): salen solas de los
/// pedidos sin pagar o se crean a mano (servicios, cuotas, cartera).
model Receivable {
  id             String    @id @default(cuid()) @map("_id")
  companyId      String
  contactId      String
  orderId        String?
  concept        String
  amount         Float
  dueDate        DateTime
  /// PENDING | PAID | CANCELLED
  status         String    @default("PENDING")
  remindersSent  Int       @default(0)
  lastReminderAt DateTime?
  paidAt         DateTime?
  notes          String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, status])
  @@index([orderId])
}

/// Informe semanal del auditor de ventas: por qué se perdieron ventas.
model SalesAudit {
  id                  String   @id @default(cuid()) @map("_id")
  companyId           String
  periodStart         DateTime
  periodEnd           DateTime
  statsJson           String
  reasonsJson         String
  recommendationsJson String
  examplesJson        String   @default("[]")
  /// IA | REGLAS (si no hubo IA disponible)
  source              String   @default("REGLAS")
  model               String?
  tokens              Int      @default(0)
  createdAt           DateTime @default(now())

  @@index([companyId, createdAt])
}

/// Incidentes 24/7: el bot no pudo responder (IA caída), un mensaje no salió,
/// un trabajo de la cola falló… Se agrupan por empresa y tipo, se avisa al
/// equipo de inmediato y se cierran solos tras 30 min sin repetirse.
model Incident {
  id         String    @id @default(cuid()) @map("_id")
  companyId  String?
  /// AI_DOWN | WA_SEND_FAILED | INBOUND_FAILED
  kind       String
  detail     String
  count      Int       @default(1)
  firstAt    DateTime  @default(now())
  lastAt     DateTime  @default(now())
  notifiedAt DateTime?
  resolvedAt DateTime?
  resolvedBy String?

  @@index([kind])
  @@index([lastAt])
}

/// Compra de un plan desde el panel de la empresa. Por ahora el pago se hace
/// por QR de Bancolombia o transferencia (el equipo contacta y confirma);
/// Wompi queda como "próximamente".
model PlanOrder {
  id                 String    @id @default(cuid()) @map("_id")
  companyId          String
  planId             String
  planName           String
  billingCycle       String    @default("MONTHLY")
  planAmount         Float
  aiPackageId        String?
  aiPackageName      String?
  aiPackageAmount    Float     @default(0)
  total              Float
  currency           String    @default("COP")
  /// REQUESTED → CONTACTED → AWAITING_PAYMENT → PAID → ACTIVE | CANCELLED
  status             String    @default("REQUESTED")
  /// QR | TRANSFER | WOMPI (el que acuerde el equipo)
  method             String?
  /// SELF ("Tu IA") | MANAGED ("Todo incluido")
  serviceMode        String    @default("SELF")
  /// Complementos pedidos [{key, qty, price}]
  addonsJson         String?
  /// Lo que recomendó el sistema y por qué (JSON)
  recommendationJson String?
  notes              String?
  requestedBy        String?
  handledBy          String?
  paidAt             DateTime?
  activatedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([companyId])
}

/// Cada intento de registro por la web, termine o no: en qué paso va, dónde se
/// quedó, qué consumió de IA y el seguimiento comercial del equipo (contacto,
/// reunión, demo). El navegador guarda solo el token de su sesión.
model SignupSession {
  id           String    @id @default(cuid()) @map("_id")
  token        String    @unique
  /// STARTED → INTERVIEW → PREVIEW → ACCOUNT → DONE
  step         String    @default("STARTED")
  answers      Int       @default(0)
  description  String?
  businessName String?
  businessType String?
  rubro        String?
  contactName  String?
  email        String?
  phone        String?
  /// ai | guided (sin IA disponible)
  mode         String?
  aiCalls      Int       @default(0)
  aiTokens     Int       @default(0)
  /// Últimos errores que vio la persona [{at, step, message}]
  errorsJson   String?
  companyId    String?
  referrer     String?
  userAgent    String?
  /// Campaña de donde llegó (?utm_source=facebook&utm_campaign=…)
  utmSource    String?
  utmCampaign  String?
  /// Clientes que le escriben al día (lo dice en el registro; base de los cálculos de IA)
  dailyChats   Int?
  /// Seguimiento del equipo: NEW | CONTACTED | MEETING | DEMO_DONE | WON | LOST
  followStatus String    @default("NEW")
  meetingAt    DateTime?
  followNotes  String?
  followBy     String?
  notifiedAt   DateTime?
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([lastSeenAt])
  @@index([followStatus])
}

/// Consumo mensual del extra "Redes sociales con IA" (lo paga BackOffice):
/// créditos usados (imagen = 1, video = 4) y costo real estimado del proveedor.
model SocialUsage {
  id        String   @id @default(cuid()) @map("_id")
  companyId String
  period    String // YYYY-MM
  images    Int      @default(0)
  videos    Int      @default(0)
  credits   Int      @default(0)
  costUsd   Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([companyId, period])
}

/// Copia en la base de cada archivo subido o generado (fotos, audios, comprobantes,
/// imágenes de IA). En hosting con disco efímero (Render) el disco es solo caché:
/// si el archivo no está, se restaura desde aquí. Máx. 12 MB por archivo.
model StoredFile {
  id        String   @id @default(cuid()) @map("_id")
  companyId String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@index([companyId])
}

/// Cita con un agente de BackOffice. Lo técnico (IA, WhatsApp, plantillas de
/// Meta) lo configuramos nosotros en una llamada: el cliente nunca queda solo.
model AgentCall {
  id          String   @id @default(cuid()) @map("_id")
  companyId   String
  userId      String?
  requestedBy String
  /// SETUP | AI | WHATSAPP | TEMPLATES | PLAN | TEAM | OTHER
  topic       String
  slotAt      DateTime
  phone       String
  notes       String?
  /// REQUESTED | CONFIRMED | DONE | CANCELLED | NO_SHOW
  status      String   @default("REQUESTED")
  agentName   String?
  meetUrl     String?
  doneNotes   String?
  cancelledBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([companyId])
  @@index([slotAt])
}

/// Foto de salud de la plataforma cada 10 minutos (Plataforma → Salud).
/// Métricas en JSON (velocidad, memoria, MongoDB, Redis, colas, gasto de IA);
/// se conservan 30 días para tendencias ("se llena en X días", "lento 3 días").
model HealthSample {
  id       String   @id @default(cuid()) @map("_id")
  at       DateTime @default(now())
  /// prod (Render) | local: las pruebas en un computador no se mezclan con producción
  env      String   @default("prod")
  bootId   String
  dataJson String

  @@index([env, at])
}

/**
 * ═══ BackOffice Creative ═══
 */

/// Identidad de marca de la empresa (una por empresa). Lo confirmado por la
/// empresa vive en los campos; lo que propone la IA queda aparte en
/// suggestionsJson hasta que alguien lo acepte (nunca se sobrescribe solo).
model BrandProfile {
  id               String   @id @default(cuid()) @map("_id")
  companyId        String   @unique
  name             String
  description      String?
  logosJson        String   @default("[]") // [{assetId, label}]
  colorsJson       String   @default("[]") // [{hex, label}]
  fontsJson        String   @default("[]") // nombres de la lista permitida
  tone             String?
  vocabularyJson   String   @default("[]")
  avoidWordsJson   String   @default("[]")
  audience         String?
  productsJson     String   @default("[]") // [{name, price?, confirmed}]
  ctasJson         String   @default("[]")
  offersJson       String   @default("[]") // [{text, price?, validUntil?}] confirmadas por la empresa
  restrictionsJson String   @default("[]") // reglas visuales y de comunicación
  formatsJson      String   @default("[]") // formatos que usa
  protectedJson    String   @default("{}") // {logo: bool, colors: bool}
  policyJson       String   @default("{}") // reglas de publicación y autonomía
  suggestionsJson  String? // propuestas de la IA pendientes de aceptar
  version          Int      @default(1)
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
  /// Identidad visual confirmada por la empresa (posicionamiento, personalidad, estilo de foto, composición, roles de color…)
  visualJson       String?
}

/// Recurso de marca subido por la empresa (logo, imagen, referencia).
/// Archivo privado: solo se sirve por un endpoint con autorización.
/// Biblioteca de recursos de la empresa, compartida por Creative y Ads Intelligence.
/// Los campos opcionales nuevos son null en los recursos anteriores (= subidos en Creative).
model BrandAsset {
  id            String   @id @default(cuid()) @map("_id")
  companyId     String
  kind          String   @default("IMAGE") // LOGO | IMAGE | REFERENCE | VIDEO
  name          String
  fileName      String
  mimeType      String
  sizeBytes     Int
  width         Int?
  height        Int?
  createdBy     String?
  createdAt     DateTime @default(now())
  /// Procedencia: UPLOAD | CATALOG | DESIGN (null = UPLOAD, los anteriores)
  source        String?
  /// Producto desde el que entró: CREATIVE | ADS (null = CREATIVE)
  originModule  String?
  /// Si salió de un diseño de Creative: cuál y en qué versión (cada versión es un recurso aparte)
  designId      String?
  designVersion Int?
  /// Versión anterior de la que deriva (el original nunca se pisa)
  derivedFromId String?
  /// Huella del contenido para no guardar dos veces el mismo archivo
  sha256        String?
  /// Video: duración en segundos (si se pudo leer del archivo)
  durationSec   Float?

  @@index([companyId, kind])
  @@index([companyId, sha256])
}

/// Un recurso de la biblioteca usado en una campaña, conjunto o anuncio.
/// Mientras exista el vínculo, el recurso no se puede borrar.
/// Es un registro interno de BackOffice: NO sube nada a la plataforma publicitaria.
model AdAssetLink {
  id         String   @id @default(cuid()) @map("_id")
  companyId  String
  assetId    String
  adEntityId String
  /// Copia para mostrar aunque la entidad cambie: META | GOOGLE | TIKTOK y CAMPAIGN | ADSET | AD
  provider   String
  level      String
  entityName String
  createdBy  String?
  createdAt  DateTime @default(now())

  @@unique([assetId, adEntityId])
  @@index([companyId, assetId])
  @@index([companyId, adEntityId])
}

/// Diseño editable por capas (documento validado y versionado, no una imagen plana).
model CreativeDesign {
  id              String   @id @default(cuid()) @map("_id")
  companyId       String
  name            String
  format          String // IG_POST | IG_PORTRAIT | STORY | FB_POST
  docJson         String
  schemaVersion   Int      @default(1)
  /// Control de concurrencia: cada guardado sube la versión; un guardado con versión vieja se rechaza
  version         Int      @default(1)
  templateKey     String?
  status          String   @default("ACTIVE") // ACTIVE | ARCHIVED
  exportFile      String?
  exportMime      String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
  /// Dirección de arte con la que se generó: {family, variant, goal, seed, content, adaptedFrom} (null en diseños anteriores)
  compositionJson String?

  @@index([companyId, status, updatedAt])
}

/// Historial de versiones de un diseño (para recuperar y deshacer entre sesiones).
model CreativeDesignVersion {
  id        String   @id @default(cuid()) @map("_id")
  designId  String
  companyId String
  version   Int
  docJson   String
  createdBy String?
  createdAt DateTime @default(now())

  @@index([designId, version])
}

/// Movimiento de créditos de Creative. idempotencyKey evita cobrar dos veces
/// la misma operación (reintentos o doble clic).
model CreativeCreditMove {
  id             String   @id @default(cuid()) @map("_id")
  companyId      String
  userId         String?
  /// RESERVE | COMMIT | RELEASE | GRANT
  kind           String
  /// TEXT | IMAGE | VIDEO | EXTRA
  operation      String
  credits        Int
  /// MONTHLY (cupo del plan) | EXTRA (paquetes)
  bucket         String   @default("MONTHLY")
  idempotencyKey String   @unique
  provider       String?
  model          String?
  costUsd        Float?
  resourceType   String?
  resourceId     String?
  note           String?
  createdAt      DateTime @default(now())

  @@index([companyId, createdAt])
}

/// Saldo extra de créditos (paquetes adicionales o regalos), aparte del cupo mensual del plan.
model CreativeWallet {
  id           String   @id @default(cuid()) @map("_id")
  companyId    String   @unique
  extraCredits Int      @default(0)
  updatedAt    DateTime @default(now())
}

// ─────────────── BackOffice Creative Ads ───────────────
// Publicidad de cada empresa (Meta / Google / TikTok). Todo va aislado por
// companyId. mode=DEMO marca datos simulados: nunca se mezclan con REAL.

/// Cuenta publicitaria conectada por una empresa.
model AdAccount {
  id          String    @id @default(cuid()) @map("_id")
  companyId   String
  /// META | GOOGLE | TIKTOK
  provider    String
  /// REAL | DEMO
  mode        String    @default("REAL")
  /// ID en la plataforma (act_123… en Meta)
  externalId  String
  name        String
  currency    String    @default("COP")
  timezone    String?
  /// Token cifrado (enc:v1:…); nunca se devuelve por el API
  tokenEnc    String?
  scopesJson  String    @default("[]")
  /// CONNECTED | EXPIRED | ERROR | DISCONNECTED
  status      String    @default("CONNECTED")
  lastSyncAt  DateTime?
  lastError   String?
  connectedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  @@unique([companyId, provider, externalId])
  @@index([companyId, status])
}

/// Campaña, conjunto/grupo de anuncios o anuncio sincronizado (capa común).
model AdEntity {
  id                 String    @id @default(cuid()) @map("_id")
  companyId          String
  accountId          String
  provider           String
  mode               String    @default("REAL")
  /// CAMPAIGN | ADSET | AD
  level              String
  externalId         String
  campaignExternalId String?
  adsetExternalId    String?
  name               String
  status             String?
  effectiveStatus    String?
  objective          String?
  /// Presupuestos en unidades de la moneda de la cuenta (ya convertidos del offset)
  dailyBudget        Float?
  lifetimeBudget     Float?
  /// Problemas de revisión o entrega reportados por la plataforma
  issuesJson         String    @default("[]")
  /// Datos originales de la plataforma (sin tokens)
  rawJson            String    @default("{}")
  providerUpdatedAt  DateTime?
  syncedAt           DateTime  @default(now())

  @@unique([accountId, level, externalId])
  @@index([companyId, level])
}

/// Métricas diarias reportadas por la plataforma (granularidad: día de la cuenta).
model AdInsightDaily {
  id                 String   @id @default(cuid()) @map("_id")
  companyId          String
  accountId          String
  mode               String   @default("REAL")
  level              String
  externalId         String
  campaignExternalId String?
  /// YYYY-MM-DD en la zona horaria de la cuenta publicitaria
  date               String
  currency           String
  spend              Float    @default(0)
  impressions        Int      @default(0)
  reach              Int      @default(0)
  clicks             Int      @default(0)
  linkClicks         Int      @default(0)
  leads              Int      @default(0)
  conversations      Int      @default(0)
  purchases          Int      @default(0)
  purchaseValue      Float    @default(0)
  rawJson            String   @default("{}")
  syncedAt           DateTime @default(now())

  @@unique([accountId, level, externalId, date])
  @@index([companyId, date])
}

/// Cada sincronización (manual o programada) con su resultado.
model AdSyncRun {
  id         String    @id @default(cuid()) @map("_id")
  companyId  String
  accountId  String
  trigger    String    @default("MANUAL")
  /// RUNNING | OK | ERROR
  status     String    @default("RUNNING")
  countsJson String    @default("{}")
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([accountId, startedAt])
}

/// Oportunidad comercial (Radar): sale de reglas deterministas sobre datos
/// reales de anuncios (ADS) o del CRM (CRM). Guarda evidencia, fuentes,
/// decisiones del usuario y el resultado observado después de actuar.
model Opportunity {
  id              String    @id @default(cuid()) @map("_id")
  companyId       String
  /// ADS | CRM
  source          String
  mode            String    @default("REAL")
  accountId       String?
  ruleKey         String
  /// Una por regla + elemento + periodo: no se duplica al re-detectar
  dedupeKey       String    @unique
  level           String?
  externalId      String?
  entityName      String?
  severity        String    @default("MEDIUM")
  title           String
  summary         String?
  /// {facts[], interpretation, assumptions[], missing[], action, expected, uncertainty}
  explanationJson String
  evidenceJson    String    @default("{}")
  /// Fuentes de los datos, p. ej. ["Meta Ads (reportado por la plataforma)", "CRM de BackOffice"]
  sourcesJson     String    @default("[]")
  periodJson      String    @default("{}")
  /// SUFFICIENT | INITIAL | MISSING_DATA (sin porcentajes inventados)
  evidence        String    @default("INITIAL")
  impactJson      String?
  /// {type, label, risk, reversible, href?, contactIds?}
  actionJson      String    @default("{}")
  /// NEW | REVIEWING | PREPARED | NEEDS_APPROVAL | EXECUTED | OBSERVING | RESULT | DISMISSED | SNOOZED
  status          String    @default("NEW")
  snoozedUntil    DateTime?
  /// [{at, by, status, note}] — cada decisión del usuario
  decisionsJson   String    @default("[]")
  /// Foto de los datos al actuar y lo observado después
  baselineJson    String?
  resultJson      String?
  actedAt         DateTime?
  resultAt        DateTime?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())

  @@index([companyId, status])
}

/// Lo que BackOffice sabe del negocio, lo que el usuario corrigió y su progreso.
model CompanyContext {
  id              String   @id @default(cuid()) @map("_id")
  companyId       String   @unique
  /// Correcciones del usuario: {clave: {value, at, by}} (pisan lo inferido)
  overridesJson   String   @default("{}")
  /// {intent, lastIntentAt}
  preferencesJson String   @default("{}")
  /// Hitos con fecha: firstVisitAt, firstValueAt, intents[], abandons…
  progressJson    String   @default("{}")
  updatedAt       DateTime @default(now())
}

/// Ajustes de publicidad por empresa: autonomía, pausa global y límites.
model AdSettings {
  id              String   @id @default(cuid()) @map("_id")
  companyId       String   @unique
  /// ANALYSIS | RECOMMEND | AUTHORIZED
  autonomy        String   @default("ANALYSIS")
  globalPause     Boolean  @default(false)
  /// Acciones que el administrador habilitó para ejecución automática (solo PAUSE por ahora)
  autoActionsJson String   @default("[]")
  /// Tope de presupuesto diario por campaña que BackOffice nunca supera
  maxDailyBudget  Float?
  /// Horas máximas de antigüedad de los datos para ejecutar algo automático
  maxDataAgeHours Int      @default(6)
  updatedBy       String?
  updatedAt       DateTime @default(now())
}

/// Regla del Autopilot (umbral configurable por la empresa).
model AdRule {
  id            String    @id @default(cuid()) @map("_id")
  companyId     String
  name          String
  /// SPEND | CPL | CTR | NO_RESULTS | SPEND_SPIKE | FREQUENCY
  metric        String
  /// CAMPAIGN | ADSET | AD
  level         String    @default("CAMPAIGN")
  windowDays    Int       @default(7)
  /// GT | LT
  operator      String    @default("GT")
  threshold     Float
  /// Gasto mínimo en la ventana para que la regla opine (evita ruido)
  minSpend      Float     @default(0)
  /// ALERT | RECOMMEND_PAUSE | PAUSE
  action        String    @default("ALERT")
  risk          String    @default("LOW")
  active        Boolean   @default(true)
  checkEveryMin Int       @default(60)
  lastRunAt     DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())

  @@index([companyId, active])
}

/// Ejecución de una regla o acción sobre una campaña (auditable y reversible si se puede).
model AdActionLog {
  id               String    @id @default(cuid()) @map("_id")
  companyId        String
  accountId        String
  mode             String    @default("REAL")
  /// RULE | USER | FINDING
  source           String
  ruleId           String?
  findingId        String?
  /// Evita ejecutar dos veces lo mismo (reintentos, doble clic)
  idempotencyKey   String    @unique
  level            String
  externalId       String
  entityName       String?
  /// PAUSE | RESUME | ALERT | RECOMMEND_PAUSE | CREATE_CAMPAIGN | SET_BUDGET
  action           String
  /// PROPOSED | EXECUTED | FAILED | REJECTED | SKIPPED
  status           String
  dataJson         String    @default("{}")
  beforeJson       String?
  afterJson        String?
  providerResponse String?
  error            String?
  reversible       Boolean   @default(false)
  actor            String?
  createdAt        DateTime  @default(now())
  decidedAt        DateTime?

  @@index([companyId, createdAt])
}

/// Brief comercial y propuesta de campaña (Campaign Studio).
model AdBrief {
  id                String   @id @default(cuid()) @map("_id")
  companyId         String
  title             String
  dataJson          String
  proposalJson      String?
  /// DRAFT | PROPOSED | CREATED
  status            String   @default("DRAFT")
  accountId         String?
  createdExternalId String?
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@index([companyId, createdAt])
}

/// Eventos de diseño para medir y aprender (sin datos personales).
model CreativeEvent {
  id        String   @id @default(cuid()) @map("_id")
  companyId String
  designId  String?
  /// composition_suggested | composition_selected | composition_rejected | manual_edit | export_completed | quality_warnings | variant_in_campaign
  type      String
  family    String?
  dataJson  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([companyId, type, createdAt])
}

/// Conexión de una empresa con Google Calendar (una por empresa). Los tokens
/// viven cifrados (encryptSecret) y jamás salen por el API.
model CalendarConnection {
  id                   String    @id @default(cuid()) @map("_id")
  companyId            String    @unique
  provider             String    @default("GOOGLE")
  /// PENDING_SELECTION | CONNECTED | ERROR | REVOKED
  status               String    @default("PENDING_SELECTION")
  /// Cuenta (id del calendario principal = correo de Google)
  accountEmail         String?
  refreshTokenEnc      String?
  accessTokenEnc       String?
  accessExpiresAt      DateTime?
  scopes               String?
  calendarId           String?
  calendarName         String?
  calendarTimeZone     String?
  /// Calendarios que se pueden elegir tras autorizar [{id, name, primary, timeZone}]
  calendarsJson        String?
  /// PUSH (BackOffice → Google) | PULL (Google → BackOffice) | BOTH
  direction            String    @default("BOTH")
  /// Qué espacios bloquean los eventos ocupados de Google (vacío = todos los activos)
  blockResourceIdsJson String    @default("[]")
  /// Los eventos de todo el día ocupan el día completo
  allDayBlocks         Boolean   @default(true)
  /// Guardar el título de los eventos externos (por defecto no: datos personales)
  importTitles         Boolean   @default(false)
  syncToken            String?
  channelId            String?
  channelResourceId    String?
  /// Huella del token del canal (el token real solo lo conoce Google)
  channelTokenHash     String?
  channelExpiresAt     DateTime?
  lastSyncAt           DateTime?
  /// OK | ERROR | RUNNING
  lastSyncStatus       String?
  lastError            String?
  failureCount         Int       @default(0)
  nextRetryAt          DateTime?
  createdBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  @@index([status])
  @@index([channelId])
}

/// Relación entre una reserva de BackOffice o un evento externo y su evento de Google.
/// origin BACKOFFICE: lo creó BackOffice (se identifica también por extendedProperties en Google).
/// origin GOOGLE: evento ajeno importado como bloqueo (sin datos personales salvo que se elija).
model CalendarEventLink {
  id              String    @id @default(cuid()) @map("_id")
  companyId       String
  connectionId    String
  origin          String
  appointmentId   String?
  externalEventId String?
  /// etag de Google en la última lectura/escritura (para detectar ediciones simultáneas)
  etag            String?
  /// Huella de lo último que BackOffice envió (evita reenviar lo mismo y los ciclos)
  pushedHash      String?
  /// Evento externo: inicio/fin (UTC), día completo y si ocupa
  startsAt        DateTime?
  endsAt          DateTime?
  allDay          Boolean   @default(false)
  busy            Boolean   @default(true)
  title           String?
  /// ACTIVE | DELETED | CONFLICT
  status          String    @default("ACTIVE")
  /// Conflicto a resolver a mano {kind, detail, googleStart?, googleEnd?, at}
  conflictJson    String?
  /// Operación pendiente hacia Google: CREATE | UPDATE | DELETE (reintentos)
  pendingOp       String?
  attempts        Int       @default(0)
  lastError       String?
  nextRetryAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())

  @@index([connectionId, externalEventId])
  @@index([companyId, appointmentId])
  @@index([companyId, origin, startsAt])
}
