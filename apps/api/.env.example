# Copia este archivo a .env y completa los valores.
# El .env real NUNCA se commitea (está en .gitignore).

# Base de datos — MongoDB Atlas (incluir el nombre de la base en la URL).
# Formato: mongodb+srv://usuario:contraseña@cluster.mongodb.net/backoffice?retryWrites=true&w=majority
DATABASE_URL=""

# Auth — generar con: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# Server
PORT=4001
CORS_ORIGIN="http://localhost:5173"

# Meta / WhatsApp (se completan cuando conectemos las cuentas reales)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:4001/integrations/meta/callback"

# DeepInfra (motor de modelos IA) — las llaves también pueden ir en Dev Tools
DEEPINFRA_API_KEY=""

# Cifrado de secretos por organización — generar con: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=""

# Redis para colas (brew services start redis)
REDIS_URL="redis://localhost:6379"

# Contraseñas de las cuentas que crean los seeds (y que usan los tests E2E/carga).
# Generar fuertes; NUNCA ponerlas en el código.
SEED_PASSWORD_SANTIAGO=
SEED_PASSWORD_DANIEL=
SEED_PASSWORD_DEV_SANTIAGO=
SEED_PASSWORD_DEV_DANIEL=
SEED_PASSWORD_EMPRESA_PRUEBA=
SEED_PASSWORD_NEXUS=

# IA genérica del registro web y el acompañamiento (Gemini), separadas por coma.
# Se usan en orden: al llegar al tope diario o si Google la marca agotada, pasa a la siguiente.
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash
GEMINI_DAILY_LIMIT=80
# Correo que recibe el aviso de cada empresa nueva registrada por la web
SIGNUP_NOTIFY_EMAIL=
