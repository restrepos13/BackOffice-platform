# Copia este archivo a .env y completa los valores.
# El .env real NUNCA se commitea (está en .gitignore).

# Base de datos — hoy SQLite local; cuando se defina la base final,
# cambiar provider en prisma/schema.prisma y esta URL.
DATABASE_URL="file:./dev.db"

# Auth — generar con: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# Server
PORT=4001
CORS_ORIGIN="http://localhost:5173"

# Meta / WhatsApp (se completan cuando conectemos las cuentas reales)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:4001/integrations/meta/callback"

# DeepInfra (motor de modelos IA) — las llaves también pueden ir en Dev Tools
DEEPINFRA_API_KEY=""
