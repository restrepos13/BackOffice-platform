# Copia este archivo a .env y completa los valores.
# El .env real NUNCA se commitea (está en .gitignore).

# Base de datos — MongoDB Atlas (incluir el nombre de la base en la URL).
# Formato: mongodb+srv://usuario:contraseña@cluster.mongodb.net/backoffice?retryWrites=true&w=majority
DATABASE_URL=""

# Auth — generar con: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# Server
PORT=4001
CORS_ORIGIN="http://localhost:5173"

# Meta / WhatsApp (se completan cuando conectemos las cuentas reales)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:4001/integrations/meta/callback"

# DeepInfra (motor de modelos IA) — las llaves también pueden ir en Dev Tools
DEEPINFRA_API_KEY=""
