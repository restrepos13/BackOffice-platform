{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backoffice-platform-90ic.onrender.com/api/:path*"
    },
    {
      "source": "/m/:path*",
      "destination": "https://backoffice-platform-90ic.onrender.com/m/:path*"
    },
    {
      "source": "/t/:path*",
      "destination": "https://backoffice-platform-90ic.onrender.com/t/:path*"
    },
    {
      "source": "/registro",
      "destination": "https://backoffice-platform-90ic.onrender.com/registro"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://backoffice-platform-90ic.onrender.com/assets/:path*"
    },
    {
      "source": "/automatizacion-de-whatsapp",
      "destination": "/automatizacion-de-whatsapp.html"
    },
    {
      "source": "/automatizacion-de-procesos",
      "destination": "/automatizacion-de-procesos.html"
    },
    {
      "source": "/crm-con-whatsapp",
      "destination": "/crm-con-whatsapp.html"
    },
    {
      "source": "/sectores/restaurantes-y-domicilios",
      "destination": "/sectores/restaurantes-y-domicilios.html"
    },
    {
      "source": "/sectores/servicios-con-citas",
      "destination": "/sectores/servicios-con-citas.html"
    },
    {
      "source": "/sectores/tiendas-y-ventas",
      "destination": "/sectores/tiendas-y-ventas.html"
    },
    {
      "source": "/sectores/inmobiliarias-y-proyectos",
      "destination": "/sectores/inmobiliarias-y-proyectos.html"
    },
    {
      "source": "/calculadora-de-ahorro",
      "destination": "/calculadora-de-ahorro.html"
    },
    {
      "source": "/guias/como-automatizar-whatsapp-de-tu-negocio",
      "destination": "/guias/como-automatizar-whatsapp-de-tu-negocio.html"
    },
    {
      "source": "/guias/cuanto-cuesta-atender-whatsapp-a-mano",
      "destination": "/guias/cuanto-cuesta-atender-whatsapp-a-mano.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/terminos",
      "destination": "/terminos.html"
    },
    {
      "source": "/eliminacion-de-datos",
      "destination": "/eliminacion-de-datos.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.gstatic.com https://apis.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://apis.google.com https://content.googleapis.com https://www.googleapis.com; worker-src 'self' blob:; frame-src 'self' https://docs.google.com https://drive.google.com https://content.googleapis.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(self), microphone=(self), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt|llms.txt|site.webmanifest|favicon.svg|favicon-48.png|apple-touch-icon.png|logo.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
